# Optional accounts (history sync). Copy to .env.local and fill in from
# Supabase dashboard -> Project Settings -> API. Both values are PUBLIC by design;
# never put the secret (service) key in this app.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
